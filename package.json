{
  "name": "agentbox-monorepo",
  "version": "0.3.0-rc.3",
  "private": true,
  "description": "AgentBox engineering skeleton",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @agentbox/web build",
